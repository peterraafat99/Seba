# =============================================================================
# SEBA AI TUTOR — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Lines starting with # are comments and are ignored.

# =============================================================================
# LLM BACKEND — Choose your AI engine
# =============================================================================

# "ollama" = local Qwen 3.5 9B on your GPU (recommended, free, private)
# "gemini" = cloud Gemini/Gemma API (requires GEMINI_API_KEY below)
LLM_BACKEND=ollama

# --- Ollama settings (used when LLM_BACKEND=ollama) ---
OLLAMA_MODEL=seba-tutor          # Name of your custom Ollama model
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=120               # Seconds before timeout (increase if model is slow to load)

# --- Cloud model settings (used when LLM_BACKEND=gemini) ---
# Switch between cloud models without code changes:
#   gemini-2.5-flash      (fast, free tier)
#   gemma-4-31b-it        (Gemma 4 31B via Google AI API)
CLOUD_MODEL=gemini-2.5-flash

# =============================================================================
# API KEYS
# =============================================================================

# Google AI / Gemini API key (only needed when LLM_BACKEND=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# SerpAPI key for real image search (the [Image of X] feature)
SERPAPI_KEY=your_serpapi_key_here

# =============================================================================
# EMBEDDING & CACHE CONFIGURATION
# =============================================================================

# EMBEDDING BACKEND:
#   "local"  = local BGE-M3 model (runs locally on CPU, no API key needed)
#   "gemini" = cloud Gemini Embedding API (0 MB local RAM usage, requires GEMINI_API_KEY)
EMBEDDING_BACKEND=local

# Local embedding model name or directory (ignored if backend is gemini)
EMBEDDING_MODEL=BAAI/bge-m3

# Caching options for local CPU models (BGE-M3 and sentiment analyzer):
#   "true"  = Keep them in system RAM (faster chatbot response, requires more RAM/32GB)
#   "false" = Unload models from RAM before calling Ollama (saves RAM, fits 16GB laptops)
CACHE_LOCAL_MODELS=false

# =============================================================================
# DATABASE
# =============================================================================

DATABASE_URL=sqlite:///./learning_platform.db
SECRET_KEY=your_jwt_secret_key_here_make_it_long_and_random

# =============================================================================
# VOICE I/O — Groq Whisper API (free tier, zero VRAM)
# =============================================================================

# Get your free API key at: https://console.groq.com
# Free tier: 28,800 seconds of audio/day (whisper-large-v3)
GROQ_API_KEY=your_groq_api_key_here

# =============================================================================
# HARDWARE CONFIGURATION
# =============================================================================
# Webcam index override for the CV classroom monitoring:
#   "0" = first webcam (usually laptop integrated webcam)
#   "1" = second webcam (usually external USB webcam like Microsoft Webcam)
# If not set, the value in the classroom's database record is used (defaults to "0").
# WEBCAM_INDEX=0

